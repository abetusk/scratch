# one-time setup
arduino-cli core update-index
arduino-cli core install arduino:avr
arduino-cli lib install MIDIUSB
sudo usermod -aG dialout $USER     # re-login afterwards

# build and flash
arduino-cli board list                     # find the port, usually /dev/ttyACM0
arduino-cli compile --fqbn arduino:avr:leonardo BikeMidi
arduino-cli upload  --fqbn arduino:avr:leonardo -p /dev/ttyACM0 BikeMidi
